---
layout: layouts/base.njk
title: Components
noindex: true
showBottomBar: true
permalink: /components/
eleventyExcludeFromCollections: true
# PLACEHOLDER CONTENT for reviewing the shared components only.
# Real matches come from content/matches/ via the site editor.
sample:
  next: { team: uslw, date: "2027-05-29T19:00:00-05:00", opponent: "Sample Opponent FC", home_away: home, venue: "Pritchard Park Stadium, Racine", status: upcoming, ticket_link: "https://example.com/tickets" }
  win: { team: usl2, date: "2027-05-23T18:00:00-05:00", opponent: "Sample United", home_away: home, venue: "Pritchard Park Stadium, Racine", status: final, rkc_score: 2, opponent_score: 1, scorers: ["Player One 34'", "Player Two 71'"], match_report: "sample-report" }
  loss: { team: mwpl, date: "2027-05-22T17:00:00-05:00", opponent: "Sample Athletic", home_away: away, venue: "Sample Field", status: final, rkc_score: 0, opponent_score: 2 }
  away: { team: usl2, date: "2027-06-02T19:30:00-05:00", opponent: "Sample City SC", home_away: away, venue: "Sample City Stadium", status: upcoming }
  postponed: { team: uslw, date: "2027-05-22T19:00:00-05:00", opponent: "Sample Rovers", home_away: away, venue: "Sample Park", status: postponed }
---
{% from "partials/match.njk" import matchCard, fixtureRow %}
<section class="section section--mist" aria-label="About this page">
  <div class="wrap stack">
    <p class="label label--quiet">Shared components · for Tim's approval</p>
    <p class="match__venue">Header, footer, buttons and match cards as built from rkc.css. Every team and match on this page is placeholder content. Real pages pull from the site editor. This page is not linked from the site and is hidden from search engines.</p>
  </div>
</section>

<section class="hero">
  <div class="hero__shade"></div>
  <div class="wrap">
    <p class="label label--quiet">Hero buttons · follow Club settings</p>
    <h1>Soccer on the Third Coast.</h1>
    {% include "partials/hero-buttons.njk" %}
  </div>
</section>

<section class="section" aria-labelledby="cards-h">
  <div class="wrap">
    <div class="section__head"><h2 id="cards-h">Match cards</h2></div>
    <div class="grid grid--2">
      {#- Date order, oldest first -#}
      {%- for m in [sample.loss, sample.postponed, sample.win, sample.next, sample.away] | sort(false, false, "date") %}
      {{ matchCard(m, next=(m == sample.next)) }}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--mist" aria-labelledby="list-h">
  <div class="wrap">
    <div class="section__head"><h2 id="list-h">Fixture list</h2></div>
    <div class="filters" role="group" aria-label="Filter matches" aria-controls="sample-fixtures">
      <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
      <button class="chip" type="button" data-filter="men" aria-pressed="false">Men</button>
      <button class="chip" type="button" data-filter="women" aria-pressed="false">Women</button>
      <button class="chip" type="button" data-filter="mwpl" aria-pressed="false">MWPL</button>
      <button class="chip" type="button" data-filter="home" aria-pressed="false">Home</button>
      <button class="chip" type="button" data-filter="away" aria-pressed="false">Away</button>
    </div>
    <div class="fixture-list" id="sample-fixtures">
      {{ fixtureRow(sample.next) }}
      {{ fixtureRow(sample.away) }}
      {{ fixtureRow(sample.win) }}
      {{ fixtureRow(sample.loss) }}
      {{ fixtureRow(sample.postponed) }}
    </div>
  </div>
</section>
