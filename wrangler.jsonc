// Cloudflare settings for rkcthirdcoast.com.
// Eleventy builds the site into _site/, and only _site/ is published.
{
  "name": "rkc-website",
  "compatibility_date": "2026-10-01",
  "previews": {},
  "preview_urls": true,
  "build": {
    // Runs before every deploy and preview: turns content/ into pages.
    "command": "npm run build"
  },
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
