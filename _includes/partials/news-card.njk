{#- One News post as a card. Usage: {% from "partials/news-card.njk" import newsCard %}{{ newsCard(post) }} -#}
{% macro newsCard(post) %}
<a class="news-card" href="{{ post.url }}" data-team="{{ post.data.team_tag | teamCode }}">
  {% if post.data.hero_photo %}<img class="news-card__img" src="{{ post.data.hero_photo }}" alt="{{ post.data.hero_photo_alt }}" loading="lazy">{% else %}<div class="news-card__img"></div>{% endif %}
  <span class="label label--red">{{ post.data.team_tag | teamShort }} · <time datetime="{{ post.date | chicago('iso') }}">{{ post.date | chicago('long') }}</time></span>
  <span class="news-card__title">{{ post.data.title | noEndPeriod }}</span>
  <span class="news-card__summary">{{ post.data.summary }}</span>
</a>
{% endmacro %}
